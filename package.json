{
  "name": "tiny-town",
  "version": "0.7.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "vitest run && playwright test",
    "verify": "node scripts/check-no-local-paths.mjs && node scripts/gen-licenses.mjs --check && npm run typecheck && npm run test:unit && npm run build",
    "verify:visual": "playwright test tests/visual.spec.ts",
    "inspect:canvas": "node scripts/inspect-threejs-canvas.mjs",
    "inspect:models": "node scripts/inspect-models.mjs",
    "inspect:object": "node scripts/inspect-object.mjs",
    "gen:sfx": "node scripts/gen-sfx-table.mjs",
    "gen:licenses": "node scripts/gen-licenses.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "lil-gui": "^0.21.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.184.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^5.0.2"
  }
}
